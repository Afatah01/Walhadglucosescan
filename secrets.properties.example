# Where the AI door is.
#
# Copy this file to "secrets.properties" and fill in the two values you got
# after deploying the function (see supabase/README.md).
#
# secrets.properties is NOT in the repository (it is in .gitignore), so these
# values never reach GitHub.
#
# Without this file the app still builds and works. It just has no address to
# call, so every answer comes from the rules engine on the phone instead —
# fully offline, no key, no setup.

walhad.ai.url=https://YOUR-PROJECT-REF.supabase.co/functions/v1/walhad-ai
walhad.ai.secret=the-long-hex-string-from-openssl-rand-hex-32
