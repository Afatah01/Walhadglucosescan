<?xml version="1.0" encoding="utf-8"?>
<!-- One ready-made question: a white card with a 1dp border and a blue pressed state. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#EAF1FE" />
            <stroke android:width="1dp" android:color="#C9DCFD" />
        </shape>
    </item>
    <item>
        <ripple android:color="#331B57E8">
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <solid android:color="@color/p_card" />
                    <stroke android:width="1dp" android:color="@color/t_violet_edge" />
                </shape>
            </item>
        </ripple>
    </item>
</selector>
