<?xml version="1.0" encoding="utf-8"?>
<!-- The NFC sign in white on a round plate in the brand colour. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <size android:width="56dp" android:height="56dp" />
            <solid android:color="@color/brand" />
        </shape>
    </item>
    <item
        android:width="32dp"
        android:height="32dp"
        android:drawable="@drawable/ic_nfc"
        android:gravity="center" />
</layer-list>
