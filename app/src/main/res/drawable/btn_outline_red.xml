<?xml version="1.0" encoding="utf-8"?>
<!-- A button that removes something: white with a thin red edge. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <solid android:color="#F1F5F9" />
            <stroke android:width="1dp" android:color="@color/p_border" />
        </shape>
    </item>
    <item>
        <ripple android:color="@color/chip">
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="26dp" />
                    <solid android:color="@color/p_card" />
                    <stroke android:width="1dp" android:color="@color/danger_stroke" />
                </shape>
            </item>
        </ripple>
    </item>
</selector>
