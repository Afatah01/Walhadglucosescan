<?xml version="1.0" encoding="utf-8"?>
<!-- A button that removes something: white with a thin red edge. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/chip">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/surface" />
            <stroke android:width="1dp" android:color="@color/danger_stroke" />
        </shape>
    </item>
</ripple>
