<?xml version="1.0" encoding="utf-8"?>
<!-- A quiet button: white with a thin pale-blue edge. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <solid android:color="#F1F5F9" />
            <stroke android:width="1dp" android:color="@color/p_border" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <ripple android:color="@color/p_blue_soft">
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="26dp" />
                    <solid android:color="#F0F6FF" />
                    <stroke android:width="1dp" android:color="@color/t_blue_edge" />
                </shape>
            </item>
        </ripple>
    </item>
    <item>
        <ripple android:color="@color/p_blue_soft">
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="26dp" />
                    <solid android:color="@color/p_card" />
                    <stroke android:width="1dp" android:color="@color/t_blue_edge" />
                </shape>
            </item>
        </ripple>
    </item>
</selector>
