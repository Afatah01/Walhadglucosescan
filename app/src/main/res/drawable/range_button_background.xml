<?xml version="1.0" encoding="utf-8"?>
<!-- One choice in a row of choices (3 h, 6 h ...). The chosen one is a solid blue pill. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <inset android:insetBottom="4dp" android:insetLeft="3dp" android:insetRight="3dp" android:insetTop="4dp">
            <shape android:shape="rectangle">
                <corners android:radius="20dp" />
                <solid android:color="@color/p_blue" />
            </shape>
        </inset>
    </item>
    <item>
        <inset android:insetBottom="4dp" android:insetLeft="3dp" android:insetRight="3dp" android:insetTop="4dp">
            <ripple android:color="@color/p_blue_soft">
                <item>
                    <shape android:shape="rectangle">
                        <corners android:radius="20dp" />
                        <solid android:color="@color/p_card" />
                        <stroke android:width="1dp" android:color="@color/t_blue_edge" />
                    </shape>
                </item>
            </ripple>
        </inset>
    </item>
</selector>
