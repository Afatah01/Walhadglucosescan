<?xml version="1.0" encoding="utf-8"?>
<!-- What the user sees when a severe alert takes the screen over (only after they allowed it). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/red"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="28dp">

    <TextView
        android:id="@+id/alertLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/on_color"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/alertValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/on_color"
        android:textSize="76sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/alertMeasured"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="@color/on_color"
        android:textSize="17sp" />

    <TextView
        style="@style/NoteText"
        android:layout_marginTop="18dp"
        android:text="@string/alert_screen_note"
        android:textColor="@color/on_color" />

    <Button
        android:id="@+id/alertOpenMonitoring"
        style="@style/OutlineButton"
        android:layout_marginTop="26dp"
        android:minWidth="220dp"
        android:text="@string/alert_screen_open_monitoring"
        android:textColor="@color/on_color" />

    <Button
        android:id="@+id/alertDismiss"
        style="@style/OutlineButton"
        android:minWidth="220dp"
        android:text="@string/alert_screen_dismiss"
        android:textColor="@color/on_color" />
</LinearLayout>
