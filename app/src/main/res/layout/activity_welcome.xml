<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <ImageView
            android:id="@+id/brandLogo"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:layout_gravity="center_horizontal"
            android:contentDescription="@string/brand_logo_description"
            android:src="@drawable/brand_logo" />

        <!-- The notice, on a yellow card -->
        <LinearLayout
            style="@style/Card"
            android:background="@drawable/card_notice">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/notice_title"
                android:textColor="@color/notice_title"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                style="@style/BodyText"
                android:text="@string/notice_text" />
        </LinearLayout>

        <!-- The unit -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="@string/welcome_unit_question" />

            <RadioGroup
                android:id="@+id/unitGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/unitMgdl"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/unit_mgdl"
                    android:textSize="16sp" />

                <RadioButton
                    android:id="@+id/unitMmoll"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/unit_mmoll"
                    android:textSize="16sp" />
            </RadioGroup>

            <TextView
                style="@style/NoteText"
                android:text="@string/welcome_unit_note" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/accept"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="48dp"
            android:text="@string/welcome_accept"
            android:textSize="16sp" />

        <Button
            android:id="@+id/start"
            style="@style/ColorButton"
            android:layout_marginTop="12dp"
            android:enabled="false"
            android:minHeight="56dp"
            android:text="@string/welcome_start"
            android:textSize="18sp" />
    </LinearLayout>
</ScrollView>
