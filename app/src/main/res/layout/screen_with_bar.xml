<?xml version="1.0" encoding="utf-8"?>
<!-- One of the four main screens: its own layout on top, the bar with the four screens under it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- The bar at the top: the logo, the name of the screen and, on the Home screen while
         live values are on, the sign that says if values are coming in. -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/top_bar"
        android:gravity="center_vertical"
        android:minHeight="60dp"
        android:orientation="horizontal"
        android:paddingBottom="9dp"
        android:paddingEnd="14dp"
        android:paddingStart="16dp"
        android:paddingTop="8dp">

        <ImageView
            android:id="@+id/topLogo"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:importantForAccessibility="no"
            android:src="@drawable/brand_logo" />

        <TextView
            android:id="@+id/topTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:textColor="@color/text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/livePill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/pill_soft"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="6dp"
            android:paddingEnd="10dp"
            android:paddingStart="6dp"
            android:paddingTop="6dp"
            android:visibility="gone">

            <com.glucosescan.app.ui.PulseDotView
                android:id="@+id/liveDot"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/livePillText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:textColor="@color/text"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/screenContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/card_stroke" />

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tabHome"
            style="@style/TabButton"
            android:drawableTop="@drawable/ic_tab_home"
            android:text="@string/tab_home" />

        <TextView
            android:id="@+id/tabAnalysis"
            style="@style/TabButton"
            android:drawableTop="@drawable/ic_tab_stats"
            android:text="@string/tab_analysis" />

        <TextView
            android:id="@+id/tabReport"
            style="@style/TabButton"
            android:drawableTop="@drawable/ic_tab_report"
            android:text="@string/tab_report" />

        <TextView
            android:id="@+id/tabMore"
            style="@style/TabButton"
            android:drawableTop="@drawable/ic_tab_more"
            android:text="@string/tab_more" />
    </LinearLayout>
</LinearLayout>
