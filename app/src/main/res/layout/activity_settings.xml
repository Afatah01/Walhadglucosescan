<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="16dp"
        android:paddingEnd="16dp"
        android:paddingStart="16dp"
        android:paddingTop="2dp">

        <!-- Unit -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="@string/unit_title" />

            <RadioGroup
                android:id="@+id/unitGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/unitMgdl"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/unit_mgdl"
                    android:textSize="16sp" />

                <RadioButton
                    android:id="@+id/unitMmoll"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/unit_mmoll"
                    android:textSize="16sp" />
            </RadioGroup>
        </LinearLayout>

        <!-- Target range -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="@string/limits_title" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/limit_low"
                    android:textColor="@color/text"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/lowMinus"
                    style="@style/StepButton"
                    android:contentDescription="@string/lower_limit_down"
                    android:text="@string/minus" />

                <TextView
                    android:id="@+id/lowValue"
                    android:layout_width="110dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/lowPlus"
                    style="@style/StepButton"
                    android:contentDescription="@string/lower_limit_up"
                    android:text="@string/plus" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/limit_high"
                    android:textColor="@color/text"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/highMinus"
                    style="@style/StepButton"
                    android:contentDescription="@string/upper_limit_down"
                    android:text="@string/minus" />

                <TextView
                    android:id="@+id/highValue"
                    android:layout_width="110dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/highPlus"
                    style="@style/StepButton"
                    android:contentDescription="@string/upper_limit_up"
                    android:text="@string/plus" />
            </LinearLayout>

            <TextView
                style="@style/NoteText"
                android:layout_marginTop="10dp"
                android:text="@string/limits_note" />
        </LinearLayout>

        <!-- Open by touching the sensor -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="@string/touch_title" />

            <Switch
                android:id="@+id/touchSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/touch_switch"
                android:textColor="@color/text"
                android:textSize="16sp" />

            <TextView
                style="@style/NoteText"
                android:layout_marginTop="4dp"
                android:text="@string/touch_note" />
        </LinearLayout>

        <!-- Data -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="@string/correction_title" />

            <TextView
                style="@style/NoteText"
                android:text="@string/settings_correction_note" />

            <Button
                android:id="@+id/openCorrection"
                style="@style/OutlineButton"
                android:layout_marginTop="10dp"
                android:text="@string/settings_correction_open" />
        </LinearLayout>

        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="@string/delete_title" />

            <TextView
                android:id="@+id/readingsCount"
                style="@style/NoteText" />

            <Button
                android:id="@+id/deleteButton"
                style="@style/DangerButton"
                android:layout_width="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/delete_button" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
