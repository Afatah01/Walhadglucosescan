<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout style="@style/Page">

        <LinearLayout style="@style/Card">

            <Switch
                android:id="@+id/liveSwitch"
                style="@style/SwitchRow"
                android:text="@string/live_switch"
                android:textStyle="bold" />

            <TextView
                style="@style/NoteText"
                android:layout_marginTop="6dp"
                android:text="@string/live_what" />
        </LinearLayout>

        <!-- What the connection does: only while live values are on -->
        <LinearLayout
            android:id="@+id/liveStatusCard"
            style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="@string/live_status_title" />

            <TextView
                android:id="@+id/liveStateText"
                style="@style/BodyText"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/liveSensorText"
                style="@style/NoteText"
                android:layout_marginTop="6dp" />

            <TextView
                android:id="@+id/liveMessageText"
                style="@style/NoteText" />

            <Button
                android:id="@+id/liveAllowBluetooth"
                style="@style/ColorButton"
                android:layout_marginTop="10dp"
                android:text="@string/live_allow_bluetooth"
                android:visibility="gone" />

            <Button
                android:id="@+id/liveAllowNotifications"
                style="@style/TonalButton"
                android:layout_marginTop="10dp"
                android:text="@string/live_allow_notifications"
                android:visibility="gone" />

            <TextView
                android:id="@+id/livePermissionNote"
                style="@style/NoteText"
                android:layout_marginTop="8dp"
                android:text="@string/live_permission_note"
                android:visibility="gone" />

            <Button
                android:id="@+id/livePairAgain"
                style="@style/OutlineButton"
                android:layout_marginTop="12dp"
                android:text="@string/live_pair_again" />
        </LinearLayout>

        <!-- What the user gives up: on a yellow card -->
        <LinearLayout
            style="@style/Card"
            android:background="@drawable/card_notice">

            <TextView
                android:id="@+id/liveWarningTitle"
                style="@style/CardTitle"
                android:text="@string/live_warning_title"
                android:textColor="@color/notice_title" />

            <TextView
                style="@style/BodyText"
                android:text="@string/live_warning" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/liveBatteryCard"
            style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="@string/live_battery_title" />

            <TextView
                android:id="@+id/liveBatteryText"
                style="@style/BodyText"
                android:text="@string/live_battery_text" />

            <Button
                android:id="@+id/liveBatteryButton"
                style="@style/TonalButton"
                android:layout_marginTop="10dp"
                android:text="@string/live_battery_button" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/liveLogCard"
            style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="@string/live_details_title" />

            <TextView
                android:id="@+id/liveLogText"
                style="@style/NoteText"
                android:fontFamily="monospace"
                android:textIsSelectable="true"
                android:textSize="12sp" />

            <Button
                android:id="@+id/liveLogCopy"
                style="@style/OutlineButton"
                android:layout_marginTop="10dp"
                android:text="@string/copy" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
