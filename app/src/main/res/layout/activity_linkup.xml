<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout style="@style/Page">

        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="@string/linkup_what_title" />

            <TextView
                style="@style/BodyText"
                android:text="@string/linkup_what" />
        </LinearLayout>

        <!-- What the link does: only while it is on -->
        <LinearLayout
            android:id="@+id/linkupStatusCard"
            style="@style/Card"
            android:visibility="gone">

            <TextView
                style="@style/CardTitle"
                android:text="@string/linkup_status_title" />

            <TextView
                android:id="@+id/linkupStateText"
                style="@style/BodyText"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/linkupPersonText"
                style="@style/NoteText"
                android:layout_marginTop="6dp" />

            <TextView
                android:id="@+id/linkupAccountText"
                style="@style/NoteText" />

            <TextView
                android:id="@+id/linkupLastText"
                style="@style/NoteText" />

            <Button
                android:id="@+id/linkupAllowNotifications"
                style="@style/TonalButton"
                android:layout_marginTop="10dp"
                android:text="@string/linkup_allow_notifications"
                android:visibility="gone" />

            <TextView
                android:id="@+id/linkupNotificationsNote"
                style="@style/NoteText"
                android:layout_marginTop="8dp"
                android:text="@string/linkup_notifications_note"
                android:visibility="gone" />

            <Button
                android:id="@+id/linkupSwitchOff"
                style="@style/OutlineButton"
                android:layout_marginTop="12dp"
                android:text="@string/linkup_switch_off" />
        </LinearLayout>

        <!-- Logging in: while the link is off, or when the server wants the user -->
        <LinearLayout
            android:id="@+id/linkupLoginCard"
            style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="@string/linkup_login_title" />

            <TextView
                style="@style/NoteText"
                android:text="@string/linkup_login_note" />

            <EditText
                android:id="@+id/linkupEmail"
                style="@style/Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:autofillHints="emailAddress"
                android:hint="@string/linkup_email_hint"
                android:imeOptions="actionNext"
                android:inputType="textEmailAddress"
                android:maxLength="200" />

            <EditText
                android:id="@+id/linkupPassword"
                style="@style/Input"
                android:layout_marginTop="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="password"
                android:hint="@string/linkup_password_hint"
                android:imeOptions="actionDone"
                android:inputType="textPassword"
                android:maxLength="200" />

            <Button
                android:id="@+id/linkupConnect"
                style="@style/ColorButton"
                android:layout_marginTop="10dp"
                android:text="@string/linkup_connect" />

            <TextView
                android:id="@+id/linkupMessage"
                style="@style/BodyText"
                android:layout_marginTop="10dp"
                android:textColor="@color/red"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            style="@style/Card"
            android:background="@drawable/card_notice">

            <TextView
                style="@style/CardTitle"
                android:text="@string/linkup_notice_title"
                android:textColor="@color/notice_title" />

            <TextView
                style="@style/BodyText"
                android:text="@string/linkup_notice" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/linkupBatteryCard"
            style="@style/Card"
            android:visibility="gone">

            <TextView
                style="@style/CardTitle"
                android:text="@string/live_battery_title" />

            <TextView
                android:id="@+id/linkupBatteryText"
                style="@style/BodyText"
                android:text="@string/live_battery_text" />

            <Button
                android:id="@+id/linkupBatteryButton"
                style="@style/TonalButton"
                android:layout_marginTop="10dp"
                android:text="@string/live_battery_button" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/linkupLogCard"
            style="@style/Card"
            android:visibility="gone">

            <TextView
                style="@style/CardTitle"
                android:text="@string/linkup_details_title" />

            <TextView
                android:id="@+id/linkupLogText"
                style="@style/NoteText"
                android:fontFamily="monospace"
                android:textIsSelectable="true"
                android:textSize="12sp" />

            <Button
                android:id="@+id/linkupLogCopy"
                style="@style/OutlineButton"
                android:layout_marginTop="10dp"
                android:text="@string/copy" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
