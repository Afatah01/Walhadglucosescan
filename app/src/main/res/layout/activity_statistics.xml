<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout style="@style/Page">

        <!-- How many days -->
        <LinearLayout
            style="@style/Card"
            android:paddingBottom="10dp"
            android:paddingEnd="10dp"
            android:paddingStart="10dp"
            android:paddingTop="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/days1"
                    style="@style/RangeButton"
                    android:contentDescription="@string/days_1"
                    android:text="@string/days_1_short" />

                <TextView
                    android:id="@+id/days7"
                    style="@style/RangeButton"
                    android:contentDescription="@string/days_7"
                    android:text="@string/days_7_short" />

                <TextView
                    android:id="@+id/days14"
                    style="@style/RangeButton"
                    android:contentDescription="@string/days_14"
                    android:text="@string/days_14_short" />

                <TextView
                    android:id="@+id/days30"
                    style="@style/RangeButton"
                    android:contentDescription="@string/days_30"
                    android:text="@string/days_30_short" />

                <TextView
                    android:id="@+id/days90"
                    style="@style/RangeButton"
                    android:contentDescription="@string/days_90"
                    android:text="@string/days_90_short" />
            </LinearLayout>

            <TextView
                android:id="@+id/statsPeriod"
                style="@style/NoteText"
                android:layout_marginTop="4dp"
                android:gravity="center" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/statsEmpty"
            style="@style/Card"
            android:visibility="gone">

            <TextView
                style="@style/BodyText"
                android:text="@string/stats_none" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/statsContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout style="@style/Card">

                <TextView
                    style="@style/CardTitle"
                    android:text="@string/stats_summary" />

                <LinearLayout
                    android:id="@+id/summaryBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <LinearLayout style="@style/Card">

                <TextView
                    style="@style/CardTitle"
                    android:text="@string/stats_ranges_title" />

                <com.glucosescan.app.ui.RangeBarView
                    android:id="@+id/rangeBar"
                    android:layout_width="match_parent"
                    android:layout_height="26dp"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:id="@+id/rangesBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/targetLine"
                    style="@style/BodyText"
                    android:layout_marginTop="8dp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                style="@style/Card"
                android:paddingEnd="10dp"
                android:paddingStart="10dp">

                <TextView
                    style="@style/CardTitle"
                    android:layout_marginStart="6dp"
                    android:text="@string/stats_day_title" />

                <com.glucosescan.app.ui.DayChartView
                    android:id="@+id/dayChart"
                    android:layout_width="match_parent"
                    android:layout_height="200dp" />

                <TextView
                    style="@style/NoteText"
                    android:layout_marginEnd="6dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginTop="6dp"
                    android:text="@string/stats_day_note" />
            </LinearLayout>

            <TextView
                style="@style/NoteText"
                android:layout_marginEnd="4dp"
                android:layout_marginStart="4dp"
                android:layout_marginTop="14dp"
                android:text="@string/stats_note" />
        </LinearLayout>
        <TextView
            style="@style/CreditLine"
            android:text="@string/powered_by_line" />
    </LinearLayout>
</ScrollView>
