<?xml version="1.0" encoding="utf-8"?>
<!-- The screen for scanning: a picture of the sensor, what to do, and what the
     last scan read from it. Nothing here is made up: the number under the
     picture is the one the sensor itself gave over NFC, or it says it is not
     available. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="28dp">

        <!-- What to do, and the sensor itself. -->
        <LinearLayout
            style="@style/Card"
            android:layout_marginTop="0dp"
            android:gravity="center_horizontal"
            android:paddingTop="8dp">

            <ImageView
                android:id="@+id/scanImage"
                android:layout_width="match_parent"
                android:layout_height="172dp"
                android:layout_marginBottom="12dp"
                android:adjustViewBounds="true"
                android:contentDescription="@string/scan_sensor_image"
                android:scaleType="fitCenter"
                android:src="@drawable/sensor_large" />

            <TextView
                android:id="@+id/scanTitle"
                style="@style/CardTitle"
                android:gravity="center"
                android:text="@string/scan_prompt"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/scanHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="@string/scan_hint"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <ProgressBar
                android:id="@+id/scanProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:indeterminate="true"
                android:visibility="gone" />

            <!-- Why nothing is being read: no NFC on the phone, or it is off. -->
            <TextView
                android:id="@+id/scanBlocked"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/card_notice"
                android:padding="12dp"
                android:textColor="@color/notice_title"
                android:textSize="14sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/scanFix"
                style="@style/ColorButton"
                android:layout_marginTop="10dp"
                android:text="@string/nfc_open_settings"
                android:visibility="gone" />
        </LinearLayout>

        <!-- What the last scan read from the sensor. -->
        <LinearLayout
            android:id="@+id/sensorCard"
            style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="@string/scan_sensor_card" />

            <!-- The number printed on the sensor box, read from the tag itself. -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/sensor_serial"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/sensorNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:letterSpacing="0.06"
                android:text="@string/scan_number_none"
                android:textColor="@color/text"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/sensorNumberNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/scan_number_note"
                android:textColor="@color/text_tertiary"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/sensorBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- What the last scan came to. -->
        <LinearLayout
            android:id="@+id/resultCard"
            style="@style/Card"
            android:visibility="gone">

            <TextView
                style="@style/CardTitle"
                android:text="@string/scan_result_card" />

            <TextView
                android:id="@+id/scanResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/text"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- How to hold the phone, and what the limits are. Nothing is promised
             that the phone cannot do. -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="@string/scan_help_card" />

            <TextView
                android:id="@+id/scanHelp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>
        <TextView
            style="@style/CreditLine"
            android:text="@string/powered_by_line" />
    </LinearLayout>
</ScrollView>
