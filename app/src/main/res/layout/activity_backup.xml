<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout style="@style/Page">

        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:drawablePadding="10dp"
                android:drawableStart="@drawable/ic_cloud"
                android:gravity="center_vertical"
                android:text="@string/backup_title" />

            <TextView
                style="@style/BodyText"
                android:text="@string/backup_what" />
        </LinearLayout>

        <!-- While the copy is on -->
        <LinearLayout
            android:id="@+id/backupStatusCard"
            style="@style/Card"
            android:visibility="gone">

            <TextView
                style="@style/CardTitle"
                android:text="@string/backup_status_title" />

            <TextView
                android:id="@+id/backupStateText"
                style="@style/BodyText"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/backupAccountText"
                style="@style/NoteText"
                android:layout_marginTop="6dp" />

            <TextView
                android:id="@+id/backupLastText"
                style="@style/NoteText" />

            <TextView
                android:id="@+id/backupWaitingText"
                style="@style/NoteText" />

            <TextView
                android:id="@+id/backupOnlineText"
                style="@style/NoteText" />

            <Button
                android:id="@+id/backupNow"
                style="@style/ColorButton"
                android:layout_marginTop="12dp"
                android:text="@string/backup_now" />

            <Button
                android:id="@+id/backupRestore"
                style="@style/TonalButton"
                android:layout_marginTop="10dp"
                android:text="@string/backup_restore" />

            <TextView
                android:id="@+id/backupStatusMessage"
                style="@style/BodyText"
                android:layout_marginTop="10dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/backupLogout"
                style="@style/OutlineButton"
                android:layout_marginTop="14dp"
                android:text="@string/backup_logout" />

            <Button
                android:id="@+id/backupDeleteOnline"
                style="@style/DangerButton"
                android:layout_marginTop="10dp"
                android:text="@string/backup_delete_online" />
        </LinearLayout>

        <!-- While the copy is off: how to make the database, and the login -->
        <LinearLayout
            android:id="@+id/backupStepsCard"
            style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="@string/backup_steps_title" />

            <TextView
                style="@style/BodyText"
                android:text="@string/backup_steps" />

            <Button
                android:id="@+id/backupCopySql"
                style="@style/OutlineButton"
                android:layout_marginTop="10dp"
                android:text="@string/backup_copy_sql" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/backupLoginCard"
            style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="@string/backup_account_title" />

            <EditText
                android:id="@+id/backupUrl"
                style="@style/Input"
                android:layout_marginTop="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/backup_url_hint"
                android:imeOptions="actionNext"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:maxLength="300" />

            <EditText
                android:id="@+id/backupKey"
                style="@style/Input"
                android:layout_marginTop="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/backup_key_hint"
                android:imeOptions="actionNext"
                android:importantForAutofill="no"
                android:inputType="textNoSuggestions|textVisiblePassword"
                android:maxLength="600" />

            <TextView
                style="@style/NoteText"
                android:layout_marginTop="10dp"
                android:text="@string/backup_account_note" />

            <EditText
                android:id="@+id/backupEmail"
                style="@style/Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:autofillHints="emailAddress"
                android:hint="@string/backup_email_hint"
                android:imeOptions="actionNext"
                android:inputType="textEmailAddress"
                android:maxLength="200" />

            <EditText
                android:id="@+id/backupPassword"
                style="@style/Input"
                android:layout_marginTop="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="password"
                android:hint="@string/backup_password_hint"
                android:imeOptions="actionDone"
                android:inputType="textPassword"
                android:maxLength="200" />

            <Button
                android:id="@+id/backupLogin"
                style="@style/ColorButton"
                android:layout_marginTop="10dp"
                android:text="@string/backup_login" />

            <Button
                android:id="@+id/backupCreate"
                style="@style/OutlineButton"
                android:layout_marginTop="10dp"
                android:text="@string/backup_create" />

            <TextView
                android:id="@+id/backupMessage"
                style="@style/BodyText"
                android:layout_marginTop="10dp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            style="@style/Card"
            android:background="@drawable/card_notice">

            <TextView
                style="@style/CardTitle"
                android:text="@string/backup_notice_title"
                android:textColor="@color/notice_title" />

            <TextView
                style="@style/BodyText"
                android:text="@string/backup_notice" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
